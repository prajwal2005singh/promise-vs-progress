# RPC endpoint for Polygon Amoy testnet.
# Get a free one from Alchemy (https://alchemy.com) or Infura (https://infura.io) --
# create an app for "Polygon Amoy" and copy the HTTPS URL. The public
# rpc-amoy.polygon.technology endpoint also works but is rate-limited.
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the wallet that will deploy the contract and pay gas.
# Create a throwaway wallet for this (e.g. a new MetaMask account) --
# never use a wallet that holds real funds. Fund it with free test MATIC
# from https://faucet.polygon.technology (select "Amoy").
DEPLOYER_PRIVATE_KEY=

# Optional: Polygonscan API key, only needed if you want `hardhat verify`
# to publish the contract source on https://amoy.polygonscan.com
POLYGONSCAN_API_KEY=
