# Google Gemini API key, used by ai_processor.py to extract structured
# project data from scraped text.
GOOGLE_API_KEY=

# --- Blockchain (ProgressRegistry contract) ---
# Same RPC URL / private key you used to deploy the contract in
# /blockchain -- see /blockchain/README.md for how to get these.
# Leave blank to run with on-chain anchoring disabled (evidence uploads
# and approvals still work, they just won't be anchored).
POLYGON_RPC_URL=
DEPLOYER_PRIVATE_KEY=
CONTRACT_ADDRESS=
