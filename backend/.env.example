# Google Gemini API key. Used by ai_processor.py to extract structured
# project data from scraped text, and by services/verification_service.py
# to score citizen-submitted evidence photos (construction visible?,
# estimated completion %, objects seen). Leave blank to run with AI photo
# scoring disabled -- uploads still work, EXIF/duplicate checks and admin
# review still apply, the AI fields just come back null.
GOOGLE_API_KEY=

# Model used for evidence-photo scoring specifically. Defaults to
# gemini-2.5-flash-lite if unset -- check ai.google.dev/gemini-api/docs/models
# if that model is ever retired.
GEMINI_VERIFICATION_MODEL=

# --- Image Engine ---
# VLM used for fine road-stage interpretation.
GEMINI_IMAGE_MODEL=gemini-3.5-flash-lite
# Optional local CLIP router trained for the 5 broad classes.
# Leave blank to run VLM-only image analysis.
PVP_CLIP_MODEL_PATH=../model/stage_classifier_video_balanced.joblib

# --- Context / authenticity checks ---
# For long road/tunnel projects, set Project.location_geometry to GeoJSON
# (LineString/MultiLineString for corridors, Polygon/MultiPolygon for areas).
# The point fields remain a fallback for legacy projects without geometry.
PROJECT_GEOFENCE_METERS=250
PVP_ALLOW_POINT_FALLBACK=true
# Linear road/tunnel projects should normally have corridor geometry before official evidence is accepted.
PVP_REQUIRE_CORRIDOR_GEOMETRY=true
PVP_PROJECT_TIMEZONE=Asia/Kolkata
CAPTURE_FUTURE_SKEW_MINUTES=5
CAPTURE_STALE_DAYS=30

# --- Blockchain (ProgressRegistry contract) ---
# Local persistent Ganache chain is the default for development.
PVP_BLOCKCHAIN_MODE=local
LOCAL_RPC_URL=http://127.0.0.1:8545
PVP_CHAIN_ID=1337
PVP_LOCAL_CHAIN_CONFIG=../blockchain/.data/local-chain.json

# Optional external Polygon Amoy mode. Only used when:
# PVP_BLOCKCHAIN_MODE=external
POLYGON_RPC_URL=
DEPLOYER_PRIVATE_KEY=
CONTRACT_ADDRESS=

# Image Engine auto-approval threshold. Results below this stay PENDING for admin review.
PVP_AUTO_APPROVE_CONFIDENCE=0.75

# GIS / project corridor estimation
PVP_GEOCODER_URL=https://nominatim.openstreetmap.org/search
PVP_ROUTER_URL=https://router.project-osrm.org/route/v1/driving
PVP_GIS_USER_AGENT=PromiseVsProgress/1.0 (replace-with-your-contact-email)
PVP_GIS_TIMEOUT_SECONDS=20
PVP_GIS_NOMINATIM_DELAY_SECONDS=1.1
PVP_GIS_DEFAULT_CITY=Bengaluru
PVP_GIS_DEFAULT_REGION=Karnataka
PVP_GIS_DEFAULT_COUNTRY=India
PVP_ALLOW_PROVISIONAL_GEOMETRY=true
