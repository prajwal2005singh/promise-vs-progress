# Google Gemini API key. Used by ai_processor.py to extract structured
# project data from scraped text, and by services/verification_service.py
# to score citizen-submitted evidence photos (construction visible?,
# estimated completion %, objects seen). Leave blank to run with AI photo
# scoring disabled -- uploads still work, EXIF/duplicate checks and admin
# review still apply, the AI fields just come back null.
GOOGLE_API_KEY=

# Model used for evidence-photo scoring specifically. Defaults to
# gemini-2.5-flash if unset -- check ai.google.dev/gemini-api/docs/models
# if that model is ever retired.
GEMINI_VERIFICATION_MODEL=

# --- Image Engine ---
# VLM used for fine road-stage interpretation.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-lite
# Optional local CLIP router trained for the 5 broad classes.
# Leave blank to run VLM-only image analysis.
PVP_CLIP_MODEL_PATH=

# --- Context / authenticity checks ---
# Project location is currently represented by a center point.
# Use a smaller/larger radius if your project registry requires it.
PROJECT_GEOFENCE_METERS=250
CAPTURE_FUTURE_SKEW_MINUTES=5
CAPTURE_STALE_DAYS=30

# --- Blockchain ---
# Development uses a persistent local Ganache/EVM test chain.
# Start it from /blockchain with: npm run chain:start
# Then deploy once with: npm run deploy:local
PVP_BLOCKCHAIN_MODE=local
PVP_LOCAL_CHAIN_CONFIG=../blockchain/.data/local-chain.json

# Optional external network mode (use only when explicitly setting
# PVP_BLOCKCHAIN_MODE=external).
POLYGON_RPC_URL=
DEPLOYER_PRIVATE_KEY=
CONTRACT_ADDRESS=

# Image Engine auto-approval threshold. Results below this stay PENDING for admin review.
PVP_AUTO_APPROVE_CONFIDENCE=0.75
